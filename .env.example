# ===========================================================================
# Escolha UM provedor. Preencha a chave dele e deixe o outro em branco.
# ===========================================================================

# Opcional: force o provedor. Se deixar em branco, deduzimos pela chave abaixo.
#   anthropic  -> so modelos Claude, todos os recursos da trilha funcionam
#   openrouter -> qualquer modelo do catalogo (GPT, Gemini, Llama, Claude...)
PROVEDOR=

# --- Opcao A: API da Anthropic (https://console.anthropic.com -> API Keys) --
ANTHROPIC_API_KEY=

# --- Opcao B: OpenRouter (https://openrouter.ai/keys) ----------------------
OPENROUTER_API_KEY=

# Modelo. Em branco usa o padrao do provedor.
#   anthropic  -> claude-opus-5
#   openrouter -> anthropic/claude-sonnet-4.5
# Rode 00_setup.py para ver a lista real disponivel na sua conta.
# Exemplos de OpenRouter:
#   openai/gpt-4o-mini
#   google/gemini-2.0-flash-001
#   meta-llama/llama-3.3-70b-instruct
MODELO=
